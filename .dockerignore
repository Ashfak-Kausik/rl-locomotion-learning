# Keep the build context small and the image free of host-specific state.
.git/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.vscode/
.idea/

# Large / regenerable artefacts — the repo is bind-mounted at runtime anyway,
# so nothing here needs to be baked into the image.
tb_logs/
*.zip
MUJOCO_LOG.TXT
policies/
media/
**/paper_figures/
**/figures/
