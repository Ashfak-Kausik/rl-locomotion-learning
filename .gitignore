# --- Python environments ----------------------------------------------------
# Anchored with a leading slash: an unanchored `env/` would also match
# stage3-go2-training/env/, which is a source package, not a virtualenv.
/.venv/
/venv/
/env/

# --- Python bytecode --------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# --- Training artefacts -----------------------------------------------------
tb_logs/
*.zip                    # SB3 model checkpoints (ppo_cartpole.zip, etc.)
MUJOCO_LOG.TXT

# --- Large external model checkpoints ---------------------------------------
# The walk-these-ways policy is an INPUT to this project, not an output.
# See docs/DEPENDENCIES.md — keep policies/README.md, ignore the weights.
policies/**
!policies/README.md

# --- Stage 3 training artefacts ---------------------------------------------
# Checkpoints and exported policies are large and regenerable from train.py.
stage3-go2-training/runs/
/runs/

# --- Editor / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store

# --- Agent tooling (local skills / Claude Code state) -----------------------
.claude/

# Local demo renders (large, regenerable) -- wherever make_video.py is run from
/demo_videos/
*.mp4
