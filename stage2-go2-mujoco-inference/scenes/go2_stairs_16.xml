<mujoco model="go2 stairs 16cm">
  <include file="go2_model/go2.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="rampmat" rgba="0.45 0.45 0.55 1"/>
    <material name="stepmat" rgba="0.5 0.42 0.38 1"/>
  </asset>
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- Flat run-up -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>
    <geom name="runup" type="box" pos="0.25 0 -0.05" size="1.2500 2.0 0.05" material="groundplane"/>
    <!-- Staircase: 10 steps, 16 cm rise, 30 cm tread -->
    <geom name="step_0" type="box" pos="1.6500 0 0.0800" size="0.1500 1.0000 0.080000" material="stepmat"/>
    <geom name="step_1" type="box" pos="1.9500 0 0.1600" size="0.1500 1.0000 0.160000" material="stepmat"/>
    <geom name="step_2" type="box" pos="2.2500 0 0.2400" size="0.1500 1.0000 0.240000" material="stepmat"/>
    <geom name="step_3" type="box" pos="2.5500 0 0.3200" size="0.1500 1.0000 0.320000" material="stepmat"/>
    <geom name="step_4" type="box" pos="2.8500 0 0.4000" size="0.1500 1.0000 0.400000" material="stepmat"/>
    <geom name="step_5" type="box" pos="3.1500 0 0.4800" size="0.1500 1.0000 0.480000" material="stepmat"/>
    <geom name="step_6" type="box" pos="3.4500 0 0.5600" size="0.1500 1.0000 0.560000" material="stepmat"/>
    <geom name="step_7" type="box" pos="3.7500 0 0.6400" size="0.1500 1.0000 0.640000" material="stepmat"/>
    <geom name="step_8" type="box" pos="4.0500 0 0.7200" size="0.1500 1.0000 0.720000" material="stepmat"/>
    <geom name="step_9" type="box" pos="4.3500 0 0.8000" size="0.1500 1.0000 0.800000" material="stepmat"/>
  </worldbody>
</mujoco>
